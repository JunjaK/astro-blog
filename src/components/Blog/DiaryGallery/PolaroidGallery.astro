---
import type { PolaroidImage } from './types';
import TegakiRenderer from 'tegaki/astro';
import caveatBundle from 'tegaki/fonts/caveat';

interface Props {
  items: PolaroidImage[];
}

const { items } = Astro.props;

function seeded(seed: number): number {
  const x = Math.sin(seed * 12.9898) * 43758.5453;
  return x - Math.floor(x);
}
function round4(n: number): number {
  return Math.round(n * 10000) / 10000;
}
function pickRotate(i: number): number {
  return round4(-14 + seeded(i + 1) * 28);
}
function pickX(i: number): number {
  return round4((seeded(i + 101) - 0.5) * 22);
}
function pickY(i: number): number {
  return round4((seeded(i + 211) - 0.3) * 22);
}
function pickScale(i: number): number {
  return round4(0.86 + seeded(i + 307) * 0.22);
}
---

<TegakiRenderer font={caveatBundle} bundle loadFont />

<div
  class="my-10"
  data-no-lightbox
  data-polaroid-gallery
  data-items={JSON.stringify(items)}
>
  <div class="grid grid-cols-2 gap-x-3 gap-y-8 py-4 md:grid-cols-3 md:gap-x-2 md:gap-y-16 md:py-10">
    {items.map((item, i) => {
      const rotate = item.rotate ?? pickRotate(i);
      const x = pickX(i);
      const y = pickY(i);
      const scale = pickScale(i);
      return (
        <button
          type="button"
          class="polaroid-card group relative block w-full cursor-pointer border-0 bg-transparent p-0 outline-none"
          style={`--pl-x: ${x}%; --pl-y: ${y}%; --pl-rotate: ${rotate}deg; --pl-scale: ${scale}; z-index: ${i};`}
          data-polaroid-index={i}
          aria-label={item.title}
        >
          <div class="relative bg-white p-2.5 pb-12 shadow-[0_14px_36px_rgba(0,0,0,0.28)] ring-1 ring-black/5">
            <div class="aspect-square w-full overflow-hidden bg-neutral-200">
              <img
                src={item.src}
                alt={item.alt ?? item.title}
                loading="lazy"
                decoding="async"
                class="block w-full object-cover"
                style="height: 100%; margin: 0;"
              />
            </div>
            {item.caption && (
              <div class="pointer-events-none absolute inset-x-3 bottom-1.5 flex items-center justify-center overflow-hidden text-neutral-700">
                <TegakiRenderer
                  font="Caveat Tegaki 3dc76002"
                  text={item.caption}
                  style="font-size: clamp(0.72rem, 2.6vw, 1.2rem); line-height: 1.1; color: inherit;"
                />
              </div>
            )}
          </div>
        </button>
      );
    })}
  </div>
</div>

<style>
  .polaroid-card {
    transform: translate(var(--pl-x), var(--pl-y)) rotate(var(--pl-rotate)) scale(var(--pl-scale));
    transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1), z-index 0s;
    will-change: transform;
  }
  .polaroid-card:hover {
    transform: translate(var(--pl-x), var(--pl-y)) rotate(0deg) scale(calc(var(--pl-scale) * 1.08));
    z-index: 100 !important;
  }
  .polaroid-card:active {
    transform: translate(var(--pl-x), var(--pl-y)) rotate(0deg) scale(calc(var(--pl-scale) * 0.97));
  }
</style>

<script>
  import { openPolaroidLightbox } from '@/store/polaroid';

  function bind(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-polaroid-gallery]').forEach((gallery) => {
      if (gallery.dataset.polaroidBound === 'true') return;
      gallery.dataset.polaroidBound = 'true';
      const items = JSON.parse(gallery.dataset.items ?? '[]');
      gallery.querySelectorAll<HTMLButtonElement>('[data-polaroid-index]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = Number.parseInt(btn.dataset.polaroidIndex ?? '0', 10);
          openPolaroidLightbox(items, index);
        });
      });
    });
  }

  bind();
  document.addEventListener('astro:page-load', () => bind());
</script>
